{
  "layer": "top",
  "position": "top",
  "height": 30,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "memory",
    "cpu",
    "temperature",
    "battery",
    "tray",
    "network",
    "clock#date",
    "clock#time"
  ],

  "battery": {
    "interval": 10,
    "states": { "warning": 30, "critical": 15 },
    "format": "  {icon}  {capacity}%",
    "format-discharging": "{icon}  {capacity}%",
    "format-icons": ["","","","",""],
    "tooltip": true
  },

  "clock#time": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "tooltip": false
  },

  "clock#date": {
    "interval": 10,
    "format": "  {:%e %b %Y}",
    "tooltip-format": "{:%e %B %Y}"
  },

  "cpu": {
    "interval": 5,
    "format": "  {usage}% ({load})",
    "states": { "warning": 70, "critical": 90 }
  },

  "memory": {
    "interval": 5,
    "format": "  {}%",
    "states": { "warning": 70, "critical": 90 }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 120
  },

  "hyprland/workspaces": {
    "format": "{id}",                 // numbers only
    "disable-scroll": true,
    "all-outputs": false,
    "sort-by-number": true,
    "on-click": "hyprctl dispatch workspace {id}"
    /* Optional: always show 1–5 on your laptop screen (adjust eDP-1 if needed)
    ,"persistent_workspaces": { "eDP-1": [1,2,3,4,5] }
    */
  },

  "temperature": {
    "critical-threshold": 80,
    "interval": 5,
    "format": "{icon}  {temperatureC}°C",
    "format-icons": ["","","","",""],
    "tooltip": true
  },

  "tray": {
    "icon-size": 21,
    "spacing": 10
  }
}
